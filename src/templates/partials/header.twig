				</li>
				<li class="header__item">
					<a class="header__link" href="news.html">
						Новости
					</a>
				</li>
				<li class="header__item">
					<a class="header__link" href="suppliers.html">
						Поставщикам
					</a>
				</li>
				<li class="header__item">
					<a class="header__link" href="buyers.html">
						Покупателям
					</a>
				</li>
				<li class="header__item">
					<a class="header__link" href="logistics.html">
