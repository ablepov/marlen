<header class="header header--{% if page == "index" %}gray{% else %}white{% endif %}">
	<div class="header__container container">
		<nav class="header__nav">
			<a class="header__logo" href="index.html">
				<img class="header__logo-img header__logo-img--white" src="images/logo.svg" width="194" height="48" alt="Логотип Marlen">
				<img class="header__logo-img header__logo-img--black" src="images/logo-black.svg" width="128" height="32" alt="Логотип Marlen">
			</a>

			<ul class="header__list">
				<li class="header__item">
					<a class="header__link" href="about.html">
