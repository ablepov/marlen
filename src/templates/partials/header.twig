							<span class="sr-only">Закрыть панель</span>
						</button>
					</li>

					<li class="header-buttons__item">
						<button class="header-buttons__btn burger" type="button">
							<span class="sr-only">Открыть меню</span>
							<span class="burger__line"></span>
						</button>
					</li>
				</ul>
