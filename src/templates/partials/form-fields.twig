<div class="form-box__inner">
	<div class="form-box__item">
		<label class="sr-only" for="name{{ formId }}">Ваше имя</label>
		<input class="form-box__input" id="name{{ formId }}" type="text" placeholder="Имя" readonly autocomplete="off">
	</div>

	<div class="form-box__item">
		<label class="sr-only" for="company{{ formId }}">Название компании</label>
		<input class="form-box__input" id="company{{ formId }}" type="text" placeholder="Название компании" readonly autocomplete="off">
	</div>

	<div class="form-box__item">
		<label class="sr-only" for="tel{{ formId }}">Ваш телефон</label>
		<input class="form-box__input" id="tel{{ formId }}" type="tel" placeholder="+7 (900) 000-00-00" readonly autocomplete="off">
	</div>

	<div class="form-box__item">
		<label class="sr-only" for="mail{{ formId }}">Ваш email</label>
		<input class="form-box__input" id="mail{{ formId }}" type="email" placeholder="Email" readonly autocomplete="off">
	</div>
</div>
