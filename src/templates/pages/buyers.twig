{% extends "../layout.twig" %}

{% block title %}Marlen | Страница покупателям{% endblock %}

{% block content %}
<div class="breadcrumbs">
	<div class="breadcrumbs__container container">
		<ul class="breadcrumbs__list">
			<li class="breadcrumbs__item">
				<a class="breadcrumbs__link" href="index.html">
					Главная
				</a>
			</li>

			<li class='breadcrumbs__item'><span class='breadcrumbs__link'>Покупателям</span></li>
		</ul>
	</div>
</div>

				<div class="title-page">
	<div class="title-page__container container">
		<h1 class="title-page__title title title--page">Покупателям
		</h1>

		<span class="title-page__line"></span>
	</div>
</div>

				<section class="hero-page">
	<div class="hero-page__container container">
		<div class="hero-page__wrapper">
			<div class="hero-page__image-box">
				<picture><source srcset="images/menu/buyers-page.webp" type="image/webp"><img class="hero-page__img" src="images/menu/buyers-page.png" alt="" loading="lazy"></picture>
			</div>

			<div class="hero-page__info">
				<h2 class="hero-page__title title title--hero">Продукты для вашего бизнеса <span class='title__element'>по выгодным ценам<span class='title__bg'></span></span></h2>

				<div class='hero-page__text'><p>Работаем с крупными торговыми сетями и мелкой розницей в Хабаровском крае, ЕАО и Приморье. Создаем комфортные условия сотрудничества для бизнеса любого масштаба.</p></div>

				<button class='hero-page__btn btn btn--dark' type='button'>Сделать заказ</button>
			</div>
		</div>
	</div>
</section>

				<section class="brands">
	<div class="brands__container container">
		<h2 class="brands__title title-split">MARLEN — дистрибьютор, которому доверяют
			6 000+ постоянных покупателей
		</h2>

		<div class="brands__wrapper section-trigger">
			<div class="brands__buttons">
				<button class="brands__btn brands__btn--prev" type="button">
					<span class="sr-only">Предыдущий слайд</span>
				</button>
				<button class="brands__btn brands__btn--next" type="button">
					<span class="brands__btn-text">Далее</span>
					<span class="sr-only">Следующий слайд</span>
				</button>
			</div>

			{% include "../partials/brand-slider.twig" with {brands: 37..62} %}
		</div>
	</div>
</section>

				<section class="why-us-buyers">
